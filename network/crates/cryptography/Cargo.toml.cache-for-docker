[package]
name = "human-crypto"
version = "0.1.0"
edition = "2021"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[dependencies]
argon2 = "0.5.1"
bcrypt = "0.15.0"
blake2 = "0.10.6"
# elliptic-curve = { version = "0.13.5", features = ["hash2curve", "arithmetic"] }
k256 = { version = "0.13.1", features = ["hash2curve", "arithmetic", "ecdh", "serde"] }
num-bigint = { version = "0.4", features = ["serde", "rand"] }
rand = "0.8.5"
rand_core = { version = "0.6.4", features = ["getrandom"] }
getrandom = { version = "0.2.10", features = ["js"] }
wasm-bindgen = "0.2.87"
serde = { version = "1.0.183", features = ["derive"]}
serde_json = "1.0.104"
sha3 = "0.10.8"
serde-wasm-bindgen = "0.5.0"
console_error_panic_hook = "0.1.7"
ff = { version = "0.13.0", features = ["derive"] }
num-traits = "0.2.17"
rsa = "0.9.6"
byteorder = "1.2.7"
thiserror = "1.0.58"
rand_chacha = "0.3.1"
axum = "0.7.5"
tokio = { version = "1.37.0", features = ["macros", "rt-multi-thread","full"] }
ethers = "2.0.14"
bincode = "1.3.3"
mongodb = { version = "2.5.0", features = []}
anyhow = "1.0.82"
redis = "0.25.3"
axum-macros = "0.4.1"
dotenv = "0.15.0"
surf = "2.3.2"
hex = "0.4.3"
futures = "0.3.30"
itertools = "0.12.1"
pinata-sdk = "1.1.0"
clap = "4.5.4"
reqwest = { version = "0.12.4", features = ["json"] }
tracing = "0.1.40"
tracing-subscriber = "0.3.18"
tower-http = { version = "0.5.2", features = ["trace"] }
ark-ed-on-bn254 = "0.4.0"
ark-ec = "0.4.2"
ark-ff = "0.4.2"
ark-std = "0.4.0"
ark-serialize = "0.4.2"
bytemuck = "1.16.0"
lazy_static = "1.4.0"
hmac = "0.12.1"
sha2 = "0.10.8"
tokio-util = "0.7.11"
chrono = "0.4.38"

[features]
testnet_logging = []
enable_credits_for_tests = []
mock_credits = []

[[bin]]
name = "observer"
path = "src/nodes/observer/bin/main.rs"

[[bin]]
name = "prover"
path = "src/nodes/prover/bin/main.rs"

[[bin]]
name = "verifier"
path = "src/nodes/verifier/bin/main.rs"

[[bin]]
name = "relayer"
path = "src/nodes/relayer/bin/main.rs"

[[bin]]
name = "test_dealer"
path = "src/nodes/test-dealer/main.rs"
[[bin]]
name = "testnet_logging"
path = "src/nodes/testnet-logging/bin/main.rs"

[[bin]]
name = "test_client"
path = "src/nodes/test-client/bin/main.rs"
