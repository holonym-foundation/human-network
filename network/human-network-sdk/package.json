{
  "name": "@human.tech/human-network-sdk",
  "version": "0.3.2",
  "description": "Human Network SDK for browser and Node.js",
  "exports": {
    "types": "./pkg/esm/human_network_sdk.d.ts",
    "require": "./pkg/cjs/human_network_sdk.js",
    "default": "./pkg/esm/human_network_sdk.js"
  },
  "main": "./dist/cjs/human_network_sdk.js",
  "module": "./dist/esm/human_network_sdk.js",
  "author": "Holonym Foundation",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build-cjs && npm run build-esm",
    "build-cjs": "wasm-pack build --target nodejs --out-dir ./pkg/cjs && rm ./pkg/cjs/.gitignore",
    "build-esm": "wasm-pack build --target web --out-dir ./pkg/esm && rm ./pkg/esm/.gitignore"
  },
  "files": [
    "/pkg"
  ]
}
